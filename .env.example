# SHIFTER_PRO — variables d'environnement
#
# IMPORTANT : ce projet est une app front-end (Vite). Vite expose au
# navigateur toute variable préfixée VITE_ — n'y mets donc jamais un
# secret. Les clés secrètes (Twitch Client Secret, service_role Supabase,
# etc.) doivent vivre uniquement côté serveur (une fonction Supabase Edge,
# une API route), jamais dans ce fichier ni dans le code de ce dépôt.

# --- Twitch (statut LIVE + Clips) --------------------------------------
# Client ID d'une app enregistrée sur https://dev.twitch.tv/console/apps
# Le Client ID seul est public/sans danger côté front.
VITE_TWITCH_CLIENT_ID=

# Le Client Secret NE DOIT PAS être préfixé VITE_ — utilisé uniquement
# côté serveur pour obtenir un app access token (Twitch Helix API).
TWITCH_CLIENT_SECRET=

# --- Supabase (inscriptions tournois, historique) -----------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Discord ---------------------------------------------------------
# Lien d'invitation réel (discord.gg/...) une fois créé — sans ça, le
# site se contente d'afficher/copier le tag BKHWW.26.
VITE_DISCORD_INVITE_URL=

# --- Business ---------------------------------------------------------
VITE_BUSINESS_CONTACT_EMAIL=
